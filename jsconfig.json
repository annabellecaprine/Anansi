{
    "compilerOptions": {
        "checkJs": true,
        "strict": false,
        "noEmit": true,
        "target": "ES2020",
        "module": "ES2020",
        "moduleResolution": "node",
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "baseUrl": ".",
        "paths": {}
    },
    "include": [
        "js/core/**/*",
        "js/panels/**/*"
    ],
    "exclude": [
        "node_modules",
        "js/lib/**/*"
    ]
}