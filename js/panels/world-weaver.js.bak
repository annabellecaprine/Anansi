/*
 * Anansi Panel: World Weaver
 * File: js/panels/world-weaver.js
 * Category: Forbidden Secrets (RPG Lock)
 * Purpose: Guided world-building wizard with LLM-driven category evaluation.
 */

(function (A) {
    'use strict';

    // ═══════════════════════════════════════════════════════════════════════════
    // GENRE TEMPLATES
    // ═══════════════════════════════════════════════════════════════════════════

    const GENRE_TEMPLATES = [
        {
            id: 'fantasy',
            label: 'Fantasy',
            icon: '⚔️',
            preSeeds: {
                worldRules: 'Magic exists. Consider: magic systems, races/species, medieval-to-renaissance tech level.',
                setting: 'This world may have kingdoms, guilds, ancient ruins, mystical forests.'
            },
            questionFocus: ['magic system', 'political structure', 'non-human races', 'prophecies or legends']
        },
        {
            id: 'scifi',
            label: 'Sci-Fi',
            icon: '🚀',
            preSeeds: {
                worldRules: 'Advanced technology exists. Consider: FTL travel, AI, cybernetics, aliens.',
                setting: 'Space stations, colony worlds, megacities, corporate dystopias.'
            },
            questionFocus: ['technology level', 'alien species', 'societal structure', 'human augmentation']
        },
        {
            id: 'romance',
            label: 'Romance',
            icon: '💕',
            preSeeds: {
                coreExperience: 'Focus on emotional connection and relationship development.',
                mechanics: 'Consider: trust/affection tracking, relationship milestones.'
            },
            questionFocus: ['relationship dynamic', 'emotional barriers', 'romantic tension', 'character chemistry']
        },
        {
            id: 'horror',
            label: 'Horror',
            icon: '👻',
            preSeeds: {
                worldRules: 'Something is wrong. The threat may be supernatural, psychological, or cosmic.',
                guardrails: 'Maintain tension and dread. The horror should feel inescapable.'
            },
            questionFocus: ['nature of the threat', 'isolation factors', 'psychological horror vs gore', 'survival odds']
        },
        {
            id: 'sliceoflife',
            label: 'Slice of Life',
            icon: '🌸',
            preSeeds: {
                worldRules: 'Realistic modern setting. No supernatural elements unless specified.',
                coreExperience: 'Focus on everyday interactions, personal growth, relationships.'
            },
            questionFocus: ['daily routines', 'social circles', 'personal struggles', 'small victories']
        },
        {
            id: 'freeform',
            label: 'Free Form',
            icon: '🎨',
            preSeeds: {},
            questionFocus: []
        }
    ];

    // ═══════════════════════════════════════════════════════════════════════════
    // CATEGORY DEFINITIONS
    // ═══════════════════════════════════════════════════════════════════════════

    const CATEGORIES = {
        coreExperience: { label: 'Core Experience', weight: 20, icon: '🎯' },
        worldRules: { label: 'World Rules', weight: 20, icon: '⚙️' },
        setting: { label: 'Setting/Situation', weight: 15, icon: '🏔️' },
        mainCharacter: { label: 'Main Character', weight: 15, icon: '👤' },
        storyArc: { label: 'Story Arc', weight: 15, icon: '📖' },
        mechanics: { label: 'Mechanics', weight: 10, icon: '🎲' },
        guardrails: { label: 'Guardrails', weight: 5, icon: '🚧' }
    };

    const CONTENT_RATINGS = [
        { id: 'sfw', label: 'SFW', description: 'Clean language, fade-to-black' },
        { id: 'nsfw_themes', label: 'NSFW (Themes)', description: 'Dark, violent, mature psychological' },
        { id: 'adult', label: 'Adult (18+)', description: 'Explicit content allowed' }
    ];

    // ═══════════════════════════════════════════════════════════════════════════
    // SESSION MANAGEMENT
    // ═══════════════════════════════════════════════════════════════════════════

    const SESSIONS_KEY = 'anansi_world_weaver_sessions';

    function loadSessions() {
        try {
            return JSON.parse(localStorage.getItem(SESSIONS_KEY) || '{}');
        } catch {
            return {};
        }
    }

    function saveSessions(sessions) {
        localStorage.setItem(SESSIONS_KEY, JSON.stringify(sessions));
    }

    function createNewSession(name, genre, contentRating, importedActor = null) {
        const id = `ww_${Date.now()}_${Math.random().toString(36).substr(2, 6)}`;
        const template = GENRE_TEMPLATES.find(t => t.id === genre) || GENRE_TEMPLATES[5]; // freeform fallback

        return {
            id,
            name: name || 'Untitled World',
            createdAt: new Date().toISOString(),
            updatedAt: new Date().toISOString(),
            genre: genre,
            contentRating: contentRating || 'sfw',
            importedActor: importedActor,

            // Category states: empty, in_progress, completed, skipped
            categories: {
                coreExperience: { status: 'empty', confidence: 0, summary: '', facts: [], gaps: [] },
                worldRules: { status: 'empty', confidence: 0, summary: '', facts: [], gaps: [] },
                setting: { status: 'empty', confidence: 0, summary: '', facts: [], gaps: [] },
                mainCharacter: { status: 'empty', confidence: 0, summary: '', facts: [], gaps: [] },
                storyArc: { status: 'empty', confidence: 0, summary: '', facts: [], gaps: [] },
                mechanics: { status: 'empty', confidence: 0, summary: '', facts: [], gaps: [] },
                guardrails: { status: 'empty', confidence: 0, summary: '', facts: [], gaps: [] }
            },

            // Pre-seed from template
            preSeeds: { ...template.preSeeds },
            questionFocus: [...template.questionFocus],

            // Chat history with LLM
            chatHistory: [],

            // Accumulated context (distilled facts)
            accumulatedContext: '',

            // Overall progress (0-100)
            overallProgress: 0,

            // Current focus category
            currentFocus: 'coreExperience',

            // Settings
            settings: {
                questionsPerRound: 3,
                tokenBudget: 4096
            }
        };
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // RENDER FUNCTION
    // ═══════════════════════════════════════════════════════════════════════════

    function render(container, context) {
        const state = A.State.get();

        // Initialize weaver state if needed
        if (!state.worldWeaver) {
            state.worldWeaver = {
                currentSessionId: null,
                showSetup: true
            };
            A.State.notify();
        }

        container.innerHTML = '';
        container.style.display = 'flex';
        container.style.flexDirection = 'column';
        container.style.height = '100%';
        container.style.overflow = 'hidden';

        // Load sessions
        const sessions = loadSessions();
        const currentSession = state.worldWeaver.currentSessionId
            ? sessions[state.worldWeaver.currentSessionId]
            : null;

        // Show setup screen or main interface
        if (state.worldWeaver.showSetup || !currentSession) {
            renderSetupScreen(container, sessions, state);
        } else {
            renderMainInterface(container, currentSession, sessions, state);
        }
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // SETUP SCREEN
    // ═══════════════════════════════════════════════════════════════════════════

    function renderSetupScreen(container, sessions, state) {
        const setup = document.createElement('div');
        setup.className = 'ww-setup';
        setup.innerHTML = `
            <style>
                .ww-setup {
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    justify-content: center;
                    height: 100%;
                    padding: 24px;
                    background: linear-gradient(135deg, var(--bg-panel) 0%, var(--bg-elevated) 100%);
                    overflow-y: auto;
                }
                .ww-setup-header {
                    text-align: center;
                    margin-bottom: 32px;
                }
                .ww-setup-title {
                    font-size: 28px;
                    font-weight: 700;
                    color: var(--text-primary);
                    margin-bottom: 8px;
                }
                .ww-setup-subtitle {
                    font-size: 14px;
                    color: var(--text-muted);
                }
                .ww-setup-form {
                    background: var(--bg-surface);
                    border: 1px solid var(--border-subtle);
                    border-radius: 12px;
                    padding: 24px;
                    width: 100%;
                    max-width: 500px;
                    box-shadow: 0 4px 20px rgba(0,0,0,0.2);
                }
                .ww-form-group {
                    margin-bottom: 20px;
                }
                .ww-form-label {
                    display: block;
                    font-size: 12px;
                    font-weight: 600;
                    color: var(--text-secondary);
                    margin-bottom: 8px;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                }
                .ww-form-input {
                    width: 100%;
                    padding: 12px;
                    background: var(--bg-panel);
                    border: 1px solid var(--border-subtle);
                    border-radius: 8px;
                    color: var(--text-primary);
                    font-size: 14px;
                }
                .ww-form-input:focus {
                    outline: none;
                    border-color: var(--accent);
                    box-shadow: 0 0 0 2px var(--accent-subtle);
                }
                .ww-genre-grid {
                    display: grid;
                    grid-template-columns: repeat(3, 1fr);
                    gap: 8px;
                }
                .ww-genre-btn {
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    justify-content: center;
                    padding: 16px 12px;
                    background: var(--bg-panel);
                    border: 2px solid var(--border-subtle);
                    border-radius: 8px;
                    cursor: pointer;
                    transition: all 0.2s;
                }
                .ww-genre-btn:hover {
                    border-color: var(--accent);
                    background: var(--bg-elevated);
                }
                .ww-genre-btn.selected {
                    border-color: var(--accent);
                    background: var(--accent-subtle);
                }
                .ww-genre-icon {
                    font-size: 24px;
                    margin-bottom: 4px;
                }
                .ww-genre-label {
                    font-size: 11px;
                    color: var(--text-secondary);
                }
                .ww-rating-options {
                    display: flex;
                    gap: 8px;
                }
                .ww-rating-btn {
                    flex: 1;
                    padding: 10px;
                    background: var(--bg-panel);
                    border: 2px solid var(--border-subtle);
                    border-radius: 8px;
                    cursor: pointer;
                    text-align: center;
                    transition: all 0.2s;
                }
                .ww-rating-btn:hover {
                    border-color: var(--accent);
                }
                .ww-rating-btn.selected {
                    border-color: var(--accent);
                    background: var(--accent-subtle);
                }
                .ww-rating-label {
                    font-size: 12px;
                    font-weight: 600;
                    color: var(--text-primary);
                }
                .ww-rating-desc {
                    font-size: 10px;
                    color: var(--text-muted);
                    margin-top: 4px;
                }
                .ww-start-btn {
                    width: 100%;
                    padding: 14px;
                    background: linear-gradient(135deg, var(--accent) 0%, var(--accent-hover) 100%);
                    border: none;
                    border-radius: 8px;
                    color: white;
                    font-size: 14px;
                    font-weight: 600;
                    cursor: pointer;
                    transition: all 0.2s;
                    margin-top: 8px;
                }
                .ww-start-btn:hover {
                    transform: translateY(-1px);
                    box-shadow: 0 4px 12px rgba(var(--accent-rgb), 0.3);
                }
                .ww-sessions-section {
                    margin-top: 24px;
                    width: 100%;
                    max-width: 500px;
                }
                .ww-sessions-header {
                    font-size: 14px;
                    font-weight: 600;
                    color: var(--text-secondary);
                    margin-bottom: 12px;
                }
                .ww-session-list {
                    display: flex;
                    flex-direction: column;
                    gap: 8px;
                }
                .ww-session-item {
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    padding: 12px 16px;
                    background: var(--bg-surface);
                    border: 1px solid var(--border-subtle);
                    border-radius: 8px;
                    cursor: pointer;
                    transition: all 0.2s;
                }
                .ww-session-item:hover {
                    border-color: var(--accent);
                }
                .ww-session-name {
                    font-weight: 600;
                    color: var(--text-primary);
                }
                .ww-session-meta {
                    font-size: 11px;
                    color: var(--text-muted);
                    margin-top: 2px;
                }
                .ww-session-progress {
                    font-size: 12px;
                    color: var(--accent);
                    font-weight: 600;
                }
                .ww-session-delete {
                    padding: 4px 8px;
                    background: transparent;
                    border: 1px solid var(--danger);
                    border-radius: 4px;
                    color: var(--danger);
                    font-size: 10px;
                    cursor: pointer;
                    margin-left: 8px;
                }
                .ww-actor-import {
                    padding: 12px;
                    background: var(--bg-panel);
                    border: 2px dashed var(--border-subtle);
                    border-radius: 8px;
                    text-align: center;
                    cursor: pointer;
                    transition: all 0.2s;
                }
                .ww-actor-import:hover {
                    border-color: var(--accent);
                }
                .ww-actor-import.has-actor {
                    border-style: solid;
                    border-color: var(--success);
                    background: rgba(var(--success-rgb), 0.1);
                }
            </style>
            
            <div class="ww-setup-header">
                <div class="ww-setup-title">🕸️ World Weaver</div>
                <div class="ww-setup-subtitle">Guided world-building for immersive storytelling</div>
            </div>
            
            <div class="ww-setup-form">
                <div class="ww-form-group">
                    <label class="ww-form-label">Session Name</label>
                    <input type="text" class="ww-form-input" id="ww-session-name" placeholder="My Adventure World">
                </div>
                
                <div class="ww-form-group">
                    <label class="ww-form-label">Genre Template</label>
                    <div class="ww-genre-grid" id="ww-genre-grid"></div>
                </div>
                
                <div class="ww-form-group">
                    <label class="ww-form-label">Content Rating</label>
                    <div class="ww-rating-options" id="ww-rating-options"></div>
                </div>
                
                <div class="ww-form-group">
                    <label class="ww-form-label">Import Actor (Optional)</label>
                    <div class="ww-actor-import" id="ww-actor-import">
                        <span>📥 Click to select an Actor from your project</span>
                    </div>
                </div>
                
                <button class="ww-start-btn" id="ww-start-btn">✨ Begin World Weaving</button>
            </div>
            
            <div class="ww-sessions-section" id="ww-sessions-section"></div>
        `;
        container.appendChild(setup);

        // State for setup form
        let selectedGenre = 'freeform';
        let selectedRating = 'sfw';
        let selectedActor = null;

        // Populate genre grid
        const genreGrid = setup.querySelector('#ww-genre-grid');
        GENRE_TEMPLATES.forEach(genre => {
            const btn = document.createElement('button');
            btn.className = `ww-genre-btn ${genre.id === selectedGenre ? 'selected' : ''}`;
            btn.innerHTML = `
                <span class="ww-genre-icon">${genre.icon}</span>
                <span class="ww-genre-label">${genre.label}</span>
            `;
            btn.onclick = () => {
                genreGrid.querySelectorAll('.ww-genre-btn').forEach(b => b.classList.remove('selected'));
                btn.classList.add('selected');
                selectedGenre = genre.id;
            };
            genreGrid.appendChild(btn);
        });

        // Populate rating options
        const ratingOptions = setup.querySelector('#ww-rating-options');
        CONTENT_RATINGS.forEach(rating => {
            const btn = document.createElement('button');
            btn.className = `ww-rating-btn ${rating.id === selectedRating ? 'selected' : ''}`;
            btn.innerHTML = `
                <div class="ww-rating-label">${rating.label}</div>
                <div class="ww-rating-desc">${rating.description}</div>
            `;
            btn.onclick = () => {
                ratingOptions.querySelectorAll('.ww-rating-btn').forEach(b => b.classList.remove('selected'));
                btn.classList.add('selected');
                selectedRating = rating.id;
            };
            ratingOptions.appendChild(btn);
        });

        // Actor import
        // Actor import
        const actorImport = setup.querySelector('#ww-actor-import');
        if (actorImport) {
            actorImport.onclick = (e) => {
                e.stopPropagation();
                console.log('[WorldWeaver] Actor import clicked');

                // Debug logs
                const state = A.State.get();
                console.log('[WorldWeaver] State nodes:', state.nodes);

                const actorItems = state.nodes?.actors?.items || {};
                const actors = Object.values(actorItems);
                console.log('[WorldWeaver] Found actors:', actors.length, actors);

                if (actors.length === 0) {
                    if (A.UI && A.UI.Toast) {
                        A.UI.Toast.show('No actors in current project', 'warning');
                    } else {
                        console.warn('[WorldWeaver] No actors and Toast not available');
                        alert('No actors in current project');
                    }
                    return;
                }

                // Create modal
                const modal = document.createElement('div');
                modal.className = 'anansi-modal';
                modal.style.cssText = 'position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.7); display:flex; align-items:center; justify-content:center; z-index:9999;';

                modal.innerHTML = `
                    <div class="anansi-modal-content" style="background:var(--bg-panel); padding:20px; border-radius:8px; width:400px; max-width:90vw; border:1px solid var(--border-subtle); box-shadow:0 4px 20px rgba(0,0,0,0.5);">
                        <h3 style="margin:0 0 16px 0; color:var(--text-primary);">Select Actor to Import</h3>
                        <div class="ww-actor-list" style="max-height:300px; overflow-y:auto; border:1px solid var(--border-subtle); border-radius:4px; padding:4px;">
                            ${actors.map(a => `
                                <div class="ww-actor-option" data-id="${a.id}" style="padding:10px; cursor:pointer; border-radius:4px; margin-bottom:4px; transition:background 0.2s;">
                                    <div style="font-weight:bold; color:var(--text-primary);">${a.name || 'Unnamed'}</div>
                                    <div style="font-size:11px; color:var(--text-muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${(a.summary || a.description || 'No description').substring(0, 100)}</div>
                                </div>
                            `).join('')}
                        </div>
                        <button class="btn-cancel" style="margin-top:16px; width:100%; padding:8px; background:var(--bg-surface); border:1px solid var(--border-subtle); color:var(--text-mobile); cursor:pointer; border-radius:4px;">Cancel</button>
                    </div>
                `;
                document.body.appendChild(modal);

                // Add hover effects via JS to avoid style scoping issues
                modal.querySelectorAll('.ww-actor-option').forEach(opt => {
                    opt.onmouseenter = () => opt.style.background = 'var(--bg-elevated)';
                    opt.onmouseleave = () => opt.style.background = 'transparent';

                    opt.onclick = () => {
                        const id = opt.dataset.id;
                        selectedActor = actors.find(a => a.id === id);
                        console.log('[WorldWeaver] Selected actor:', selectedActor);

                        actorImport.innerHTML = `
                            <div style="display:flex; align-items:center; justify-content:center; gap:8px;">
                                <span>✅</span>
                                <div>
                                    <div style="font-weight:bold;">${selectedActor.name}</div>
                                    <div style="font-size:11px; opacity:0.7;">Ready to import</div>
                                </div>
                            </div>
                        `;
                        actorImport.classList.add('has-actor');
                        modal.remove();
                    };
                });

                modal.querySelector('.btn-cancel').onclick = () => modal.remove();
            };
        } else {
            console.error('[WorldWeaver] Actor import button not found');
        }

        // Start button
        setup.querySelector('#ww-start-btn').onclick = () => {
            const name = setup.querySelector('#ww-session-name').value.trim();
            const session = createNewSession(name, selectedGenre, selectedRating, selectedActor);

            // Save session
            const allSessions = loadSessions();
            allSessions[session.id] = session;
            saveSessions(allSessions);

            // Set as current
            state.worldWeaver.currentSessionId = session.id;
            state.worldWeaver.showSetup = false;
            A.State.notify();

            // Refresh panel
            A.UI.refresh();
        };

        // Render existing sessions
        const sessionsSection = setup.querySelector('#ww-sessions-section');
        const sessionList = Object.values(sessions);
        if (sessionList.length > 0) {
            sessionsSection.innerHTML = `
                <div class="ww-sessions-header">📂 Resume a Session</div>
                <div class="ww-session-list"></div>
            `;
            const list = sessionsSection.querySelector('.ww-session-list');
            sessionList.sort((a, b) => new Date(b.updatedAt) - new Date(a.updatedAt)).forEach(session => {
                const item = document.createElement('div');
                item.className = 'ww-session-item';
                item.innerHTML = `
                    <div>
                        <div class="ww-session-name">${session.name}</div>
                        <div class="ww-session-meta">${GENRE_TEMPLATES.find(t => t.id === session.genre)?.icon || '🎨'} ${GENRE_TEMPLATES.find(t => t.id === session.genre)?.label || 'Free Form'} • ${new Date(session.updatedAt).toLocaleDateString()}</div>
                    </div>
                    <div style="display: flex; align-items: center;">
                        <span class="ww-session-progress">${session.overallProgress || 0}%</span>
                        <button class="ww-session-delete" data-id="${session.id}">🗑️</button>
                    </div>
                `;
                item.onclick = (e) => {
                    if (e.target.classList.contains('ww-session-delete')) {
                        e.stopPropagation();
                        if (confirm(`Delete session "${session.name}"?`)) {
                            const all = loadSessions();
                            delete all[session.id];
                            saveSessions(all);
                            A.UI.refresh();
                        }
                        return;
                    }
                    state.worldWeaver.currentSessionId = session.id;
                    state.worldWeaver.showSetup = false;
                    A.State.notify();
                    A.UI.refresh();
                };
                list.appendChild(item);
            });
        }
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // MAIN INTERFACE
    // ═══════════════════════════════════════════════════════════════════════════

    function renderMainInterface(container, session, sessions, state) {
        const main = document.createElement('div');
        main.className = 'ww-main';
        main.innerHTML = `
            <style>
                .ww-main {
                    display: flex;
                    height: 100%;
                    overflow: hidden;
                }
                .ww-sidebar {
                    width: 280px;
                    background: var(--bg-elevated);
                    border-right: 1px solid var(--border-subtle);
                    display: flex;
                    flex-direction: column;
                    overflow: hidden;
                }
                .ww-sidebar-header {
                    padding: 16px;
                    border-bottom: 1px solid var(--border-subtle);
                    background: var(--bg-surface);
                }
                .ww-session-title {
                    font-size: 16px;
                    font-weight: 700;
                    color: var(--text-primary);
                    margin-bottom: 4px;
                }
                .ww-session-genre {
                    font-size: 12px;
                    color: var(--text-muted);
                }
                .ww-progress-section {
                    padding: 16px;
                    border-bottom: 1px solid var(--border-subtle);
                }
                .ww-progress-header {
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    margin-bottom: 8px;
                }
                .ww-progress-label {
                    font-size: 11px;
                    font-weight: 600;
                    color: var(--text-secondary);
                    text-transform: uppercase;
                }
                .ww-progress-value {
                    font-size: 14px;
                    font-weight: 700;
                    color: var(--accent);
                }
                .ww-progress-bar {
                    height: 8px;
                    background: var(--bg-panel);
                    border-radius: 4px;
                    overflow: hidden;
                }
                .ww-progress-fill {
                    height: 100%;
                    background: linear-gradient(90deg, var(--accent) 0%, var(--success) 100%);
                    transition: width 0.3s ease;
                }
                .ww-categories {
                    flex: 1;
                    overflow-y: auto;
                    padding: 12px;
                }
                .ww-category {
                    display: flex;
                    align-items: center;
                    gap: 10px;
                    padding: 10px 12px;
                    background: var(--bg-surface);
                    border: 1px solid var(--border-subtle);
                    border-radius: 8px;
                    margin-bottom: 8px;
                    cursor: pointer;
                    transition: all 0.2s;
                }
                .ww-category:hover {
                    border-color: var(--accent);
                }
                .ww-category.active {
                    border-color: var(--accent);
                    background: var(--accent-subtle);
                }
                .ww-category.completed {
                    border-color: var(--success);
                }
                .ww-category.skipped {
                    opacity: 0.5;
                }
                .ww-category-icon {
                    font-size: 18px;
                }
                .ww-category-info {
                    flex: 1;
                    min-width: 0;
                }
                .ww-category-name {
                    font-size: 12px;
                    font-weight: 600;
                    color: var(--text-primary);
                }
                .ww-category-status {
                    font-size: 10px;
                    color: var(--text-muted);
                }
                .ww-category-weight {
                    font-size: 10px;
                    color: var(--text-muted);
                    padding: 2px 6px;
                    background: var(--bg-panel);
                    border-radius: 10px;
                }
                .ww-category-confidence {
                    width: 32px;
                    height: 32px;
                    border-radius: 50%;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 10px;
                    font-weight: 700;
                    color: white;
                }
                .ww-sidebar-actions {
                    padding: 12px;
                    border-top: 1px solid var(--border-subtle);
                    display: flex;
                    flex-direction: column;
                    gap: 8px;
                }
                .ww-action-btn {
                    padding: 10px;
                    border-radius: 6px;
                    font-size: 12px;
                    font-weight: 600;
                    cursor: pointer;
                    border: 1px solid var(--border-subtle);
                    background: var(--bg-surface);
                    color: var(--text-primary);
                    transition: all 0.2s;
                }
                .ww-action-btn:hover {
                    border-color: var(--accent);
                }
                .ww-action-btn.primary {
                    background: var(--accent);
                    border-color: var(--accent);
                    color: white;
                }
                .ww-content {
                    flex: 1;
                    display: flex;
                    flex-direction: column;
                    overflow: hidden;
                }
                .ww-chat-header {
                    padding: 16px;
                    background: var(--bg-elevated);
                    border-bottom: 1px solid var(--border-subtle);
                }
                .ww-focus-label {
                    font-size: 11px;
                    color: var(--text-muted);
                    text-transform: uppercase;
                    margin-bottom: 4px;
                }
                .ww-focus-category {
                    font-size: 18px;
                    font-weight: 700;
                    color: var(--text-primary);
                }
                .ww-chat-messages {
                    flex: 1;
                    overflow-y: auto;
                    padding: 16px;
                    display: flex;
                    flex-direction: column;
                    gap: 16px;
                }
                .ww-message {
                    max-width: 85%;
                    padding: 12px 16px;
                    border-radius: 12px;
                    font-size: 13px;
                    line-height: 1.5;
                }
                .ww-message.user {
                    align-self: flex-end;
                    background: var(--accent);
                    color: white;
                    border-bottom-right-radius: 4px;
                }
                .ww-message.assistant {
                    align-self: flex-start;
                    background: var(--bg-elevated);
                    color: var(--text-primary);
                    border: 1px solid var(--border-subtle);
                    border-bottom-left-radius: 4px;
                }
                .ww-message-question {
                    font-weight: 600;
                    margin-bottom: 8px;
                }
                .ww-message-suggestion {
                    font-size: 11px;
                    color: var(--text-muted);
                    font-style: italic;
                    margin-top: 8px;
                    padding-top: 8px;
                    border-top: 1px solid var(--border-subtle);
                }
                .ww-chat-input-area {
                    padding: 16px;
                    background: var(--bg-elevated);
                    border-top: 1px solid var(--border-subtle);
                }
                .ww-chat-input-wrapper {
                    display: flex;
                    gap: 8px;
                }
                .ww-chat-input {
                    flex: 1;
                    padding: 12px 16px;
                    background: var(--bg-surface);
                    border: 1px solid var(--border-subtle);
                    border-radius: 8px;
                    color: var(--text-primary);
                    font-size: 13px;
                    resize: none;
                    min-height: 44px;
                    max-height: 120px;
                }
                .ww-chat-input:focus {
                    outline: none;
                    border-color: var(--accent);
                }
                .ww-send-btn {
                    padding: 12px 20px;
                    background: var(--accent);
                    border: none;
                    border-radius: 8px;
                    color: white;
                    font-weight: 600;
                    cursor: pointer;
                }
                .ww-send-btn:disabled {
                    opacity: 0.5;
                    cursor: not-allowed;
                }
                .ww-empty-state {
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    justify-content: center;
                    height: 100%;
                    color: var(--text-muted);
                    text-align: center;
                    padding: 24px;
                }
                .ww-empty-icon {
                    font-size: 48px;
                    margin-bottom: 16px;
                }
                .ww-empty-title {
                    font-size: 16px;
                    font-weight: 600;
                    color: var(--text-secondary);
                    margin-bottom: 8px;
                }
                .ww-empty-hint {
                    font-size: 13px;
                    max-width: 300px;
                }
                .ww-quick-actions {
                    display: flex;
                    gap: 8px;
                    margin-top: 16px;
                }
            </style>
            
            <div class="ww-sidebar">
                <div class="ww-sidebar-header">
                    <div class="ww-session-title">${session.name}</div>
                    <div class="ww-session-genre">${GENRE_TEMPLATES.find(t => t.id === session.genre)?.icon || '🎨'} ${GENRE_TEMPLATES.find(t => t.id === session.genre)?.label || 'Free Form'} • ${CONTENT_RATINGS.find(r => r.id === session.contentRating)?.label || 'SFW'}</div>
                </div>
                
                <div class="ww-progress-section">
                    <div class="ww-progress-header">
                        <span class="ww-progress-label">Overall Progress</span>
                        <span class="ww-progress-value">${session.overallProgress}%</span>
                    </div>
                    <div class="ww-progress-bar">
                        <div class="ww-progress-fill" style="width: ${session.overallProgress}%"></div>
                    </div>
                </div>
                
                <div class="ww-categories" id="ww-categories"></div>
                
                <div class="ww-sidebar-actions">
                    <button class="ww-action-btn" id="ww-back-btn">↩️ Back to Sessions</button>
                    <button class="ww-action-btn" id="ww-context-btn" style="background: var(--bg-surface); border: 1px solid var(--border-subtle); width: 100%; margin-bottom: 8px;">👁️ View Active Context</button>
                    <button class="ww-action-btn primary" id="ww-generate-btn" ${session.overallProgress < 50 ? 'disabled' : ''}>✨ Generate Output</button>
                </div>
            </div>
            
            <div class="ww-content">
                <div class="ww-chat-header">
                    <div class="ww-focus-label">Current Focus</div>
                    <div class="ww-focus-category">${CATEGORIES[session.currentFocus]?.icon || '🎯'} ${CATEGORIES[session.currentFocus]?.label || 'Core Experience'}</div>
                </div>
                
                <div class="ww-chat-messages" id="ww-chat-messages"></div>
                
                <div class="ww-chat-input-area">
                    <div class="ww-chat-input-wrapper">
                        <textarea class="ww-chat-input" id="ww-chat-input" placeholder="Describe your world or answer the questions..." rows="1"></textarea>
                        <button class="ww-send-btn" id="ww-send-btn">Send</button>
                    </div>
                </div>
            </div>
        `;
        container.appendChild(main);

        // Populate categories
        const categoriesContainer = main.querySelector('#ww-categories');
        Object.entries(CATEGORIES).forEach(([key, cat]) => {
            const catState = session.categories[key];
            const confidence = catState?.confidence || 0;
            const status = catState?.status || 'empty';

            // Determine color based on confidence
            let bgColor = 'var(--text-muted)'; // empty
            if (confidence > 0 && confidence < 50) bgColor = 'var(--warning)';
            else if (confidence >= 50 && confidence < 80) bgColor = 'var(--accent)';
            else if (confidence >= 80) bgColor = 'var(--success)';
            if (status === 'skipped') bgColor = 'var(--text-muted)';

            const catEl = document.createElement('div');
            catEl.className = `ww-category ${key === session.currentFocus ? 'active' : ''} ${status}`;
            catEl.innerHTML = `
                <span class="ww-category-icon">${cat.icon}</span>
                <div class="ww-category-info">
                    <div class="ww-category-name">${cat.label}</div>
                    <div class="ww-category-status">${status === 'empty' ? 'Not started' : status === 'in_progress' ? 'In progress' : status === 'completed' ? 'Complete' : 'Skipped'}</div>
                </div>
                <span class="ww-category-weight">${cat.weight}%</span>
                <div class="ww-category-confidence" style="background: ${bgColor}">${confidence}</div>
            `;
            catEl.onclick = () => {
                session.currentFocus = key;
                saveSessions(sessions);
                A.UI.Toast.show(`Focus switched to ${cat.label}`, 'info');
                A.UI.refresh();
            };
            categoriesContainer.appendChild(catEl);
        });

        // Populate chat messages
        const chatMessages = main.querySelector('#ww-chat-messages');
        if (session.chatHistory.length === 0) {
            chatMessages.innerHTML = `
                <div class="ww-empty-state">
                    <div class="ww-empty-icon">🕸️</div>
                    <div class="ww-empty-title">Begin Weaving Your World</div>
                    <div class="ww-empty-hint">Start by describing the kind of world or experience you want to create. The AI will guide you through building out each aspect.</div>
                    <div class="ww-quick-actions">
                        <button class="ww-action-btn" id="ww-start-chat">💬 Start with a Description</button>
                    </div>
                </div>
            `;
            const startChat = chatMessages.querySelector('#ww-start-chat');
            if (startChat) {
                startChat.onclick = () => {
                    main.querySelector('#ww-chat-input').focus();
                };
            }
        } else {
            session.chatHistory.forEach(msg => {
                const msgEl = document.createElement('div');
                msgEl.className = `ww-message ${msg.role}`;
                if (msg.role === 'assistant' && msg.question) {
                    msgEl.innerHTML = `
                        <div class="ww-message-question">${msg.question}</div>
                        ${msg.content || ''}
                        ${msg.suggestion ? `<div class="ww-message-suggestion">💡 ${msg.suggestion}</div>` : ''}
                    `;
                } else {
                    msgEl.textContent = msg.content;
                }
                chatMessages.appendChild(msgEl);
            });
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        // Event handlers
        main.querySelector('#ww-back-btn').onclick = () => {
            state.worldWeaver.showSetup = true;
            A.State.notify();
            A.UI.refresh();
        };

        
        main.querySelector('#ww-context-btn').onclick = () => {
             showContextModal(session);
        };
    
main.querySelector('#ww-generate-btn').onclick = () => {
            if (session.overallProgress < 50) {
                A.UI.showToast('Complete at least 50% of your world before generating', { type: 'warning' });
                return;
            }
            showGenerationModal(session, sessions);
        };

        const input = main.querySelector('#ww-chat-input');
        const sendBtn = main.querySelector('#ww-send-btn');

        // Auto-resize textarea
        input.addEventListener('input', () => {
            input.style.height = 'auto';
            input.style.height = Math.min(input.scrollHeight, 120) + 'px';
        });

        // Send message
        const sendMessage = async () => {
            const text = input.value.trim();
            if (!text) return;

            // Add user message to UI immediately
            const chatMessages = main.querySelector('#ww-chat-messages');

            // Remove empty state if present
            const emptyState = chatMessages.querySelector('.ww-empty-state');
            if (emptyState) emptyState.remove();

            // Create and append user message
            const userMsgEl = document.createElement('div');
            userMsgEl.className = 'ww-message user';
            userMsgEl.textContent = text;
            chatMessages.appendChild(userMsgEl);
            chatMessages.scrollTop = chatMessages.scrollHeight;

            // Clear input
            input.value = '';
            input.style.height = 'auto';

            // Add 'Thinking...' indicator
            const thinkingEl = document.createElement('div');
            thinkingEl.className = 'ww-message assistant thinking';
            thinkingEl.innerHTML = `<em>Thinking...</em>`;
            chatMessages.appendChild(thinkingEl);
            chatMessages.scrollTop = chatMessages.scrollHeight;

            // Update session data
            session.chatHistory.push({ role: 'user', content: text });
            sessions[session.id] = session;
            saveSessions(sessions);

            // Call LLM
            sendBtn.disabled = true;
            sendBtn.textContent = '...';

            try {
                await evaluateAndRespond(session, sessions);
            } catch (err) {
                console.error('[WorldWeaver] LLM error:', err);
                A.UI.Toast.show('Error getting AI response', 'error');
            } finally {
                // Formatting clean up
                if (thinkingEl && thinkingEl.parentNode) {
                    thinkingEl.remove();
                }

                sendBtn.disabled = false;
                sendBtn.textContent = 'Send';
                A.UI.refresh();
            }
        };

        sendBtn.onclick = sendMessage;
        input.onkeydown = (e) => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendMessage();
            }
        };
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // LLM EVALUATION
    // ═══════════════════════════════════════════════════════════════════════════

    async function evaluateAndRespond(session, sessions) {
        const template = GENRE_TEMPLATES.find(t => t.id === session.genre) || GENRE_TEMPLATES[5];
        const ratingInfo = CONTENT_RATINGS.find(r => r.id === session.contentRating) || CONTENT_RATINGS[0];

        // Build context
        const contextParts = [];

        // 1. Add pre-seeds
        if (Object.keys(template.preSeeds).length > 0) {
            contextParts.push('PRE-SEEDED CONTEXT:\n' + Object.entries(template.preSeeds).map(([k, v]) => `- ${CATEGORIES[k]?.label || k}: ${v}`).join('\n'));
        }

        // 2. Add imported actor if present (Priority Context)
        if (session.importedActor) {
            const a = session.importedActor;
            let actorContext = `IMPORTED ACTOR PROFILE (Definitive Source for Main Character):\n`;
            actorContext += `Name: ${a.name}\n`;
            if (a.gender) actorContext += `Gender: ${a.gender}\n`;
            if (a.pronouns) actorContext += `Pronouns: ${a.pronouns}\n`;

            // Description & Summary
            if (a.description) actorContext += `Description: ${a.description}\n`;
            if (a.summary && a.summary !== a.description) actorContext += `Summary: ${a.summary}\n`;

            // Traits / Personality
            if (a.traits) {
                if (typeof a.traits === 'string') {
                    actorContext += `Traits: ${a.traits}\n`;
                } else {
                    // Handle object traits (personality, etc)
                    Object.entries(a.traits).forEach(([k, v]) => {
                        actorContext += `${k.charAt(0).toUpperCase() + k.slice(1)}: ${v}\n`;
                    });
                }
            }

            // Notes
            if (a.notes) actorContext += `Notes: ${a.notes}\n`;

            contextParts.push(actorContext);
        }

        // 3. Add chat history
        session.chatHistory.forEach(msg => {
            if (msg.role === 'user') {
                contextParts.push(`USER: ${msg.content}`);
            } else if (msg.role === 'assistant' && msg.content) {
                contextParts.push(`ESTABLISHED: ${msg.content}`);
            }
        });

        // Dynamic System Prompt Construction
        const isAdult = session.contentRating === 'adult';
        const isNSFW = session.contentRating === 'nsfw' || isAdult;

        const personality = isAdult
            ? "You are a bold, unfiltered creative partner. The user has explicitly opted into Adult content. Do NOT be prudish or moralizing. If the user wants erotica/smut or describes a SCENARIO (e.g. heat, sex, encounter), focus IMMEDIATELY on heat, mechanics, desire, and the scene itself. Do not ask high-level literary questions. Accept the scenario as the 'Core Experience'."
            : "You are a creative muse and World-Building Analyst.";

        const systemPrompt = `${personality}
Your goal is to help the user build a rich, coherent world.

=== SESSION CONTEXT ===
Genre: ${template.label}
Content Rating: ${ratingInfo.label} (${ratingInfo.description})
Questions per round: ${session.settings.questionsPerRound}
CURRENT FOCUS: ${CATEGORIES[session.currentFocus]?.label || 'General'}

=== YOUR TASK ===
Analyze the ACCUMULATED CONTEXT and:
1. Evaluate completeness of each category (0-100%)
2. Identify the highest-priority gap
3. Generate ${session.settings.questionsPerRound} targeted questions with suggestions

=== SMART ANALYSIS RULES ===
1. **IMPORTED ACTOR PRIORITY**: If an "IMPORTED ACTOR PROFILE" is present, the "Main Character" category is 100% COMPLETE. Do NOT ask basic questions about personality, appearance, or traits if they are in the profile. Use the profile data to drive the story/scenario instead.
2. **IMMEDIATE SCENARIO**: If the user provides a specific scenario (e.g., "Amara is in heat"), accept this as the "Core Experience" and "Setting". Do not ask "what is the goal?". The goal is the scenario.
3. **ADULT CONTENT**: "No limits" is a valid Guardrail. Mark it complete.
4. **IMPLICATIONS**: "Smut/Erotica" implies Core Experience goal = Arousal/Interaction. Mark it >50% complete.

=== CATEGORY RUBRICS ===

**Core Experience (20%)** - COMPLETE when:
- Primary goal is clear (Story vs. Game vs. Erotica) OR a Scenario is active
- Tone is established

**World Rules (20%)** - COMPLETE when:
- Physics/magic/tech basics defined
- (For NSFW) Anatomy/Biology rules defined if relevant

**Setting/Situation (15%)** - COMPLETE when:
- Location/Era defined
- Initial situation established

**Main Character (15%)** - COMPLETE when:
- Defined via IMPORTED ACTOR PROFILE
- OR Name/Appearance/Archetypes defined

**Story Arc (15%)** - COMPLETE when:
- Conflict/Tension defined
- OR The "loop"/encounter structure is clear

**Mechanics (10%)** - COMPLETE when:
- Tracking systems (Stats, Trust, Corruption, etc.)



=== OUTPUT FORMAT ===
Respond ONLY with valid JSON:
{
  "analysis": "Brief 1-2 sentence summary of current state. Be conversational.",
  "categories": {
    "coreExperience": { "confidence": 0-100, "summary": "...", "gaps": ["..."] },
    "worldRules": { "confidence": 0-100, "summary": "...", "gaps": ["..."] },
    "setting": { "confidence": 0-100, "summary": "...", "gaps": ["..."] },
    "mainCharacter": { "confidence": 0-100, "summary": "...", "gaps": ["..."] },
    "storyArc": { "confidence": 0-100, "summary": "...", "gaps": ["..."] },
    "mechanics": { "confidence": 0-100, "summary": "...", "gaps": ["..."] },
    "guardrails": { "confidence": 0-100, "summary": "...", "gaps": ["..."] }
  },
  "overallProgress": 0-100,
  "highestPriority": "categoryKey",
  "deepMiningPoint": "The most interesting unexplored tension or opportunity",
  "questions": [
    {
      "text": "The question to ask",
      "category": "categoryKey",
      "suggestion": "A helpful example or starting point",
      "importance": "critical|helpful|polish"
    }
  ]
}`;

        const userMessage = `=== ACCUMULATED CONTEXT ===
${contextParts.join('\n\n')}

Please evaluate and generate questions.`;

        try {
            const maxTokens = A.UI?.getMaxTokensFor?.('worldWeaver') || session.settings.tokenBudget || 4096;

            // LLM.generate expects: generate(system, history, config)
            const history = [{ role: 'user', content: userMessage }];
            const responseText = await A.LLM.generate(
                systemPrompt,
                history,
                { maxTokens: maxTokens, temperature: 0.7 }
            );
            const response = { text: responseText };

            if (!responseText) {
                throw new Error('Empty LLM response');
            }

            // Parse JSON response
            let parsed;
            try {
                // Try to extract JSON from response
                const jsonMatch = response.text.match(/\{[\s\S]*\}/);
                if (jsonMatch) {
                    parsed = JSON.parse(jsonMatch[0]);
                } else {
                    throw new Error('No JSON found in response');
                }
            } catch (parseErr) {
                // Try with JSONRepair if available
                if (A.JSONRepair) {
                    try {
                        const repaired = A.JSONRepair.repair(response.text);
                        parsed = JSON.parse(repaired);
                    } catch {
                        throw new Error('Failed to parse LLM response as JSON');
                    }
                } else {
                    throw parseErr;
                }
            }

            // Update session with evaluation results
            if (parsed.categories) {
                Object.entries(parsed.categories).forEach(([key, val]) => {
                    if (session.categories[key]) {
                        session.categories[key].confidence = val.confidence || 0;
                        session.categories[key].summary = val.summary || '';
                        session.categories[key].gaps = val.gaps || [];

                        // Update status based on confidence
                        if (val.confidence >= 80) {
                            session.categories[key].status = 'completed';
                        } else if (val.confidence > 0) {
                            session.categories[key].status = 'in_progress';
                        }
                    }
                });
            }

            if (parsed.overallProgress !== undefined) {
                session.overallProgress = parsed.overallProgress;
            }

            if (parsed.highestPriority && CATEGORIES[parsed.highestPriority]) {
                session.currentFocus = parsed.highestPriority;
            }

            // Add assistant response with questions
            if (parsed.questions && parsed.questions.length > 0) {
                const firstQ = parsed.questions[0];
                session.chatHistory.push({
                    role: 'assistant',
                    question: firstQ.text,
                    content: parsed.analysis || '',
                    suggestion: firstQ.suggestion,
                    category: firstQ.category,
                    allQuestions: parsed.questions
                });
            } else {
                session.chatHistory.push({
                    role: 'assistant',
                    content: parsed.analysis || 'I\'ve analyzed your input. What else would you like to develop?'
                });
            }

            // Save session
            session.updatedAt = new Date().toISOString();
            sessions[session.id] = session;
            saveSessions(sessions);

        } catch (err) {
            console.error('[WorldWeaver] Evaluation error:', err);
            session.chatHistory.push({
                role: 'assistant',
                content: 'I had trouble analyzing that. Could you try rephrasing or providing more details?'
            });
            sessions[session.id] = session;
            saveSessions(sessions);
        }
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // GENERATION MODAL
    // ═══════════════════════════════════════════════════════════════════════════

        function showGenerationModal(session, sessions) {
        const modal = document.createElement('div');
        modal.className = 'anansi-modal';
        // Inline styles to ensure visibility
        modal.style.cssText = `
            position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
            background: rgba(0, 0, 0, 0.75); display: flex; align-items: center; justify-content: center;
            z-index: 9999; backdrop-filter: blur(4px);
        `;
        
        modal.innerHTML = `
            <div class="anansi-modal-content" style="max-width: 500px; background: var(--bg-surface); padding: 24px; border-radius: 12px; border: 1px solid var(--border-subtle); box-shadow: 0 10px 40px rgba(0,0,0,0.5);">
                <h3 style="margin-top: 0;">🕸️ Generate World Output</h3>
                <p style="color: var(--text-muted); margin-bottom: 24px;">Your world is ${session.overallProgress}% complete. Choose an output format:</p>
                
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <button class="ww-gen-option" data-type="character">
                        <span style="font-size: 24px;">👤</span>
                        <div>
                            <strong>Character Card</strong>
                            <div style="font-size: 12px; color: var(--text-muted);">Generate a detailed main character profile</div>
                        </div>
                    </button>
                    <button class="ww-gen-option" data-type="world">
                        <span style="font-size: 24px;">🌍</span>
                        <div>
                            <strong>World + Character</strong>
                            <div style="font-size: 12px; color: var(--text-muted);">Generate world lorebook entries + character</div>
                        </div>
                    </button>
                    <button class="ww-gen-option" data-type="export">
                        <span style="font-size: 24px;">📄</span>
                        <div>
                            <strong>Export World Doc</strong>
                            <div style="font-size: 12px; color: var(--text-muted);">Download as markdown document</div>
                        </div>
                    </button>
                </div>
                
                <button class="btn-secondary" style="margin-top: 24px; width: 100%; padding: 12px; background: transparent; border: 1px solid var(--border-subtle); color: var(--text-primary); border-radius: 6px; cursor: pointer;">Cancel</button>
            </div>
            
            <style>
                .ww-gen-option {
                    display: flex;
                    align-items: center;
                    gap: 16px;
                    padding: 16px;
                    background: var(--bg-elevated);
                    border: 1px solid var(--border-subtle);
                    border-radius: 8px;
                    cursor: pointer;
                    text-align: left;
                    transition: all 0.2s;
                    color: var(--text-primary);
                }
                .ww-gen-option:hover {
                    border-color: var(--accent);
                    background: var(--bg-base);
                    transform: translateY(-2px);
                }
            </style>
        `;
        document.body.appendChild(modal);

        modal.querySelectorAll('.ww-gen-option').forEach(btn => {
            btn.onclick = () => {
                const type = btn.dataset.type;
                modal.remove();
                handleGeneration(session, sessions, type);
            };
        });

        modal.querySelector('.btn-secondary').onclick = () => modal.remove();
    }

        async function handleGeneration(session, sessions, type) {
        if (A.UI?.Toast?.show) A.UI.Toast.show(`Generating ${type}...`, 'info');

        // Build comprehensive context
        const contextSummary = Object.entries(session.categories)
            .filter(([_, cat]) => cat.summary)
            .map(([key, cat]) => `## ${CATEGORIES[key]?.label || key}\n${cat.summary}`)
            .join('\n\n');

        switch (type) {
            case 'character':
                if (A.UI?.Toast?.show) A.UI.Toast.show('Generating Character Profile...', 'info');
                try {
                    const charPrompt = `
You are an expert character designer.
Based on the following world context, generate a detailed MAIN CHARACTER profile.
Return ONLY valid JSON:
{
    "name": "Name",
    "description": "Short physical description and vibe (1-2 sentences)",
    "summary": "Detailed background, role, and personality summary",
    "traits": ["Trait 1", "Trait 2", "Trait 3"],
    "notes": "Additional notes on conflict, goals, and relationships"
}

=== CONTEXT ===
${contextSummary}
`;
                    const charResponse = await A.LLM.generate(charPrompt, [], { maxTokens: 2048, temperature: 0.7 });
                    let charData;
                    try {
                         const match = charResponse.match(/\{[\s\S]*\}/);
                         if (match) charData = JSON.parse(match[0]);
                         else throw new Error("No JSON");
                    } catch (e) {
                         if (A.JSONRepair) charData = JSON.parse(A.JSONRepair.repair(charResponse));
                         else throw e;
                    }
                    showReviewModal(charData, 'character', session);
                } catch (err) {
                    console.error('Character generation failed:', err);
                    if (A.UI?.Toast?.show) A.UI.Toast.show('Failed to generate character', 'error');
                }
                break;

            case 'world':
                if (A.UI?.Toast?.show) A.UI.Toast.show('Generating World Lorebook...', 'info');
                try {
                    const worldPrompt = `
You are an expert world builder.
Based on the following world context, generate key LOREBOOK ENTRIES.
Focus on the most important rules, locations, factions, and mechanics.
Return ONLY valid JSON:
{
    "entries": [
        {
            "title": "Entry Title",
            "keys": ["key1", "key2"],
            "content": "Detailed description of this aspect of the world.",
            "category": "World | Location | Faction | Mechanic | Rule | History"
        }
    ]
}

=== CONTEXT ===
${contextSummary}
`;
                    const worldResponse = await A.LLM.generate(worldPrompt, [], { maxTokens: 4096, temperature: 0.7 });
                    let worldData;
                    try {
                         const match = worldResponse.match(/\{[\s\S]*\}/);
                         if (match) worldData = JSON.parse(match[0]);
                         else throw new Error("No JSON");
                    } catch (e) {
                         if (A.JSONRepair) worldData = JSON.parse(A.JSONRepair.repair(worldResponse));
                         else throw e;
                    }
                    showReviewModal(worldData, 'world', session);
                } catch (err) {
                    console.error('World generation failed:', err);
                    if (A.UI?.Toast?.show) A.UI.Toast.show('Failed to generate world lore', 'error');
                }
                break;

            case 'actor':
                 if (A.UI?.Toast?.show) A.UI.Toast.show('Use "Character Card" option instead.', 'info');
                 break;

            case 'export':
                const markdown = `# ${session.name}

**Genre:** ${GENRE_TEMPLATES.find(t => t.id === session.genre)?.label || 'Free Form'}
**Content Rating:** ${CONTENT_RATINGS.find(r => r.id === session.contentRating)?.label || 'SFW'}
**Created:** ${new Date(session.createdAt).toLocaleDateString()}

---

${contextSummary}

---

## Chat History

${session.chatHistory.map(m => m.role === 'user' ? `**You:** ${m.content}` : `**AI:** ${m.question || m.content}`).join('\n\n')}
`;
                const blob = new Blob([markdown], { type: 'text/markdown' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `${session.name.replace(/[^a-z0-9]/gi, '_')}_world.md`;
                a.click();
                URL.revokeObjectURL(url);
                A.UI.showToast('World document exported!', { type: 'success' });
                break;
        }
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // REVIEW / IMPORT LOGIC
    // ═══════════════════════════════════════════════════════════════════════════

    function showReviewModal(data, type, session) {
        const modal = document.createElement('div');
        // Inline styles to guarantee visibility
        modal.style.cssText = `
            position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
            background: rgba(0, 0, 0, 0.75); display: flex; align-items: center; justify-content: center;
            z-index: 10000; backdrop-filter: blur(4px);
        `;

        const jsonString = JSON.stringify(data, null, 2);

        modal.innerHTML = `
            <div class="anansi-modal-content" style="
                width: 800px; max-width: 90vw; height: 80vh; 
                background: var(--bg-surface); display: flex; flex-direction: column;
                border-radius: 12px; border: 1px solid var(--border-subtle); 
                box-shadow: 0 10px 40px rgba(0,0,0,0.5); overflow: hidden;">
                
                <div style="padding: 16px 24px; border-bottom: 1px solid var(--border-subtle); display: flex; justify-content: space-between; align-items: center;">
                    <h3 style="margin: 0;">📝 Review Generated Content (${type})</h3>
                    <button class="btn-close" style="background:none; border:none; cursor:pointer; font-size: 20px; color: var(--text-muted);">✕</button>
                </div>

                <div style="flex: 1; padding: 16px; overflow: hidden; display: flex; flex-direction: column;">
                    <div style="margin-bottom: 8px; font-size: 12px; color: var(--text-muted);">
                        Review and edit the JSON below before importing. This will overwrite existing data if IDs conflict.
                    </div>
                    <textarea class="json-editor" style="
                        flex: 1; width: 100%; resize: none; 
                        background: var(--bg-base); color: var(--text-primary); 
                        font-family: monospace; font-size: 13px; padding: 12px;
                        border: 1px solid var(--border-subtle); border-radius: 8px;
                    " spellcheck="false">${jsonString}</textarea>
                </div>
                
                <div style="padding: 16px 24px; border-top: 1px solid var(--border-subtle); display: flex; justify-content: flex-end; gap: 12px;">
                    <button class="btn-secondary" id="review-cancel" style="padding: 8px 16px; background: var(--bg-elevated); border: 1px solid var(--border-subtle); border-radius: 6px; cursor:pointer; color: var(--text-primary);">Cancel</button>
                    <button class="btn-primary" id="review-import" style="padding: 8px 16px; background: var(--accent); color: white; border: none; border-radius: 6px; cursor:pointer; font-weight: 600;">Confirm & Import</button>
                </div>
            </div>
        `;
        document.body.appendChild(modal);

        const textarea = modal.querySelector('.json-editor');

        const close = () => modal.remove();
        modal.querySelector('.btn-close').onclick = close;
        modal.querySelector('#review-cancel').onclick = close;

        modal.querySelector('#review-import').onclick = () => {
            try {
                const finalData = JSON.parse(textarea.value);
                importGeneratedContent(finalData, type, session);
                modal.remove();
                if (A.UI?.Toast?.show) A.UI.Toast.show('Content successfully imported!', 'success');
            } catch (err) {
                if (A.UI?.Toast?.show) A.UI.Toast.show('Invalid JSON: ' + err.message, 'error');
                else alert('Invalid JSON: ' + err.message);
            }
        };
    }

    function importGeneratedContent(data, type, session) {
        const state = A.State.get();

        if (type === 'character') {
            const actorId = `char_${Date.now()}`;
            // Use existing ID if present in data, or generate new
            const finalId = data.id || actorId;

            const newActor = {
                id: finalId,
                name: data.name || 'Unnamed',
                description: data.description || '',
                summary: data.summary || '',
                traits: data.traits || [],
                notes: data.notes || '',
                gender: data.gender || 'unknown',
                type: 'character',
                system_prompt: '',
                post_history_instructions: '',
                creator_notes: `Generated by World Weaver from session: ${session.name}`,
                tags: ['Generated', 'WorldWeaver'],
                alternate_greetings: [],
                avatar: ''
            };

            if (!state.nodes.actors) state.nodes.actors = { items: {} };
            state.nodes.actors.items[finalId] = newActor;
        }
        else if (type === 'world') {
            if (!state.weaves) state.weaves = {};
            if (!state.weaves.lorebook) state.weaves.lorebook = { entries: {} };

            let count = 0;
            const timestamp = Date.now();

            (data.entries || []).forEach((entry, idx) => {
                const id = entry.id || `lore_${timestamp}_${idx}`;
                const uuid = crypto.randomUUID();

                state.weaves.lorebook.entries[id] = {
                    id: id,
                    title: entry.title,
                    keywords: entry.keys || entry.keywords || [],
                    content: entry.content,
                    enabled: true,
                    priority: 50,
                    category: (entry.category || 'uncategorized').toLowerCase(),
                    requireTags: [],
                    blocksTags: [],
                    tags: ['Generated'],
                    shifts: [],
                    uuid: uuid
                };
                count++;
            });
        }

        A.State.notify();
    }

    
    function showContextModal(session) {
        // Reconstruct context exactly as the LLM sees it
        const template = GENRE_TEMPLATES.find(t => t.id === session.genre) || GENRE_TEMPLATES[5];
        
        let actorContext = "None";
        if (session.importedActor) {
            const a = session.importedActor;
            actorContext = "IMPORTED ACTOR PROFILE (Definitive Source):\n";
            actorContext += "Name: " + a.name + "\n";
            if(a.description) actorContext += "Description: " + a.description + "\n";
            if(a.summary) actorContext += "Summary: " + a.summary + "\n";
            if(a.notes) actorContext += "Notes: " + a.notes + "\n";
            // ... truncated for brevity in preview, key bits are above
        }

        const contextSummary = Object.entries(session.categories)
            .filter(([_, cat]) => cat.summary)
            .map(([key, cat]) => "## " + (CATEGORIES[key]?.label || key) + "\n" + cat.summary)
            .join('\n\n');

        const fullContext = `=== ACTOR DATA ===\n${actorContext}\n\n=== WORLD STATE ===\n${contextSummary}`;

        const modal = document.createElement('div');
        modal.style.cssText = `
            position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
            background: rgba(0, 0, 0, 0.75); display: flex; align-items: center; justify-content: center;
            z-index: 10001; backdrop-filter: blur(4px);
        `;
        
        modal.innerHTML = `
            <div style="width: 800px; max-width: 90vw; height: 80vh; background: var(--bg-surface); display: flex; flex-direction: column; border-radius: 12px; box-shadow: 0 10px 40px rgba(0,0,0,0.5); overflow: hidden;">
                <div style="padding: 16px; border-bottom: 1px solid var(--border-subtle); display: flex; justify-content: space-between;">
                    <h3 style="margin:0">🧠 Active LLM Context</h3>
                    <button class="btn-close" style="background:none; border:none; color:var(--text-muted); cursor:pointer; font-size: 20px;">✕</button>
                </div>
                <div style="flex: 1; padding: 0; overflow: hidden;">
                    <textarea style="width: 100%; height: 100%; background: var(--bg-base); color: var(--text-primary); border: none; padding: 16px; font-family: monospace; resize: none;" readonly>${fullContext}</textarea>
                </div>
            </div>
        `;
        
        document.body.appendChild(modal);
        modal.querySelector('.btn-close').onclick = () => modal.remove();
        modal.onclick = (e) => { if (e.target === modal) modal.remove(); };
    }
    

    A.registerPanel('world_weaver', {
        label: 'World Weaver',
        subtitle: 'Guided World-Building',
        category: 'Forbidden Secrets',
        subcategory: 'Creation',
        order: 5,
        icon: '🕸️',
        render: render
    });

    console.log('[WorldWeaver] Panel registered');

})(window.Anansi);
